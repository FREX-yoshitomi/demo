# Expo アプリの設定。EXPO_PUBLIC_ 接頭辞の値は**バンドルに埋め込まれる**ので、
# 秘密情報（サービスアカウント鍵・Claude APIキー等）は絶対に置かない。
# 秘密情報は Secret Manager に置き、Cloud Functions 側で読む。

# Firebase Web アプリの設定（Firebase Console → プロジェクト設定 → マイアプリ）
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=worklog-dev
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google サインイン（GCP Console → 認証情報 → OAuth 2.0 クライアント ID）
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ローカル開発でエミュレータに繋ぐ場合
EXPO_PUBLIC_USE_EMULATOR=false
# 実機から繋ぐときは開発マシンの LAN IP にする（127.0.0.1 では届かない）
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# development / preview / production
APP_VARIANT=development
