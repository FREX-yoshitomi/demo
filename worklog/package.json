{
  "name": "worklog",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @worklog/shared build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @worklog/rules-tests test",
    "emulators": "firebase emulators:start --project worklog-dev",
    "seed": "FIRESTORE_EMULATOR_HOST=${FIRESTORE_EMULATOR_HOST:-127.0.0.1:8080} FIREBASE_AUTH_EMULATOR_HOST=${FIREBASE_AUTH_EMULATOR_HOST:-127.0.0.1:9099} GCLOUD_PROJECT=${GCLOUD_PROJECT:-worklog-dev} tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@worklog/shared": "workspace:*",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^14.24.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
