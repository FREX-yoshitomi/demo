{
  "name": "@worklog/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,auth,storage --project worklog-test \"vitest run --config vitest.emulator.config.ts\"",
    "serve": "pnpm build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "pnpm build && firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@worklog/shared": "workspace:*",
    "dayjs": "^1.11.21",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "firebase-tools": "^14.24.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
